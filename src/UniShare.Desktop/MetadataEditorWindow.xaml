<Window x:Class="UniShare.Desktop.MetadataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UniShare.Desktop"
        Title="Editar elemento" Height="570" Width="600" WindowStartupLocation="CenterOwner"
        MinHeight="470" MinWidth="480" ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Editar metadatos" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Título *" /><TextBox x:Name="TitleBox" Margin="0,4,0,0" Padding="8" AutomationProperties.Name="Título" />
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0"><TextBlock Text="Fuente" /><TextBox x:Name="SourceBox" Margin="0,4,0,0" Padding="8" AutomationProperties.Name="Fuente" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Autor" /><TextBox x:Name="AuthorBox" Margin="0,4,0,0" Padding="8" AutomationProperties.Name="Autor" /></StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="Etiquetas (separadas por comas)" /><TextBox x:Name="TagsBox" Margin="0,4,0,0" Padding="8" AutomationProperties.Name="Etiquetas separadas por comas" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Colecciones (separadas por comas)" /><TextBox x:Name="CollectionsBox" Margin="0,4,0,0" Padding="8" AutomationProperties.Name="Colecciones separadas por comas" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Resumen o notas" />
            <Border x:Name="DescriptionPreview" Margin="0,4,0,0" Padding="9"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                <local:LinkifiedTextBlock x:Name="DescriptionPreviewText" TextWrapping="Wrap"
                                            AutomationProperties.Name="Resumen o notas en modo lectura" />
            </Border>
            <Button x:Name="ModifyDescriptionButton" Content="Modificar resumen" Margin="0,8,0,0"
                    Padding="10,6" HorizontalAlignment="Left" Click="ModifyDescription_Click" />
            <TextBox x:Name="DescriptionBox" Margin="0,4,0,0" Padding="8" AcceptsReturn="True" Height="100"
                     Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Editar resumen o notas" />
            <CheckBox x:Name="FavoriteBox" Content="Favorito" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="14,8" Margin="0,0,8,0" />
            <Button Content="Guardar cambios" Click="Save_Click" IsDefault="True" Padding="14,8"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
