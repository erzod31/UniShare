<Window x:Class="UniShare.Desktop.AppUpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actualizar UniShare" Icon="pack://application:,,,/Assets/UniShare.ico" Width="560" Height="390" MinWidth="450" MinHeight="350"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" Closed="Window_Closed">
    <StackPanel Margin="24">
        <TextBlock x:Name="VersionText" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="ChannelText" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" Margin="0,18,0,0" TextWrapping="Wrap" MinHeight="70"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Margin="0,12" />
        <WrapPanel Margin="0,10,0,0">
            <Button x:Name="CheckButton" Click="Check_Click" Margin="0,0,8,8" />
            <Button x:Name="DownloadButton" Click="Download_Click" Margin="0,0,8,8" IsEnabled="False" />
            <Button x:Name="InstallButton" Click="Install_Click" Margin="0,0,8,8" IsEnabled="False" />
            <Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,8,8" IsEnabled="False" />
        </WrapPanel>
    </StackPanel>
</Window>
