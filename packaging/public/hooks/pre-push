#!/bin/sh
repository_root=$(git rev-parse --show-toplevel) || exit 1
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoLogo -NoProfile -File "$repository_root/packaging/public/check-public-push.ps1"
else
    exec powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$repository_root/packaging/public/check-public-push.ps1"
fi
