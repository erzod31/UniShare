* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
gradlew text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.png binary
*.ico binary
*.zip binary
*.apk binary
*.exe binary
*.wasm binary
# Translation asset hashes refer to these exact upstream/bundled bytes, also on Windows checkouts.
shared/translation/*.js text eol=lf
shared/translation/*.json text eol=lf
shared/translation/*.html text eol=lf
shared/translation/vendor/*.js text eol=lf
shared/translation/vendor/*.json text eol=lf

# Instrucciones locales de trabajo: no forman parte del proyecto público.
AGENTS.md export-ignore
SOURCE_REVISION export-subst
docs/*DG-* export-ignore
packaging/public/hooks/* text eol=lf
